# Local development (copy to .env and export, or set in your shell)
DEBUG=true
SECRET_KEY=change-me-for-local-only
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional locally — SQLite is used when DATABASE_URL is unset
# DATABASE_URL=postgresql://user:pass@localhost:5432/profbingo

# Required on Render for live WebSocket scoreboards (provided by Blueprint)
# REDIS_URL=redis://...
